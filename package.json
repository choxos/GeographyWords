{
  "name": "geography-words",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3021}",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "validate:places": "python3 scripts/validate-places.py",
    "validate:layers": "node --experimental-strip-types --no-warnings scripts/validate-layers.mjs",
    "test:e2e": "playwright test",
    "data:stories": "node scripts/split-stories.mjs",
    "validate:coverage": "python3 scripts/coverage-ledger.py",
    "validate:seo": "node --experimental-strip-types --no-warnings scripts/seo-audit.mjs",
    "tour": "node scripts/record-tour.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "maplibre-gl": "^6.9.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
